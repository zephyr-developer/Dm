# ==========================================
# TeleMemer - Telegram RPG & Economy Bot Config
# ==========================================

# Telegram Bot Token obtained from @BotFather on Telegram (Required)
BOT_TOKEN="1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# Telegram Bot Username (without @)
BOT_USERNAME="TeleMemerBot"

# Owner Credentials (Underground Commands: /incluck, /generatecoin, /givepremium, /removepremium)
OWNER_USERNAME="tzhunyuan"
OWNER_ID="123456789"

# PostgreSQL Database Connection String (Neon, Supabase, Render, Railway, AWS RDS, etc.)
# If unset, the bot safely operates on an in-memory mock during local development/testing.
DATABASE_URL="postgres://postgres:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"
POSTGRES_URL=""

# Web Port & 24/7 Anti-Sleep Keep-Alive
PORT=3000
KEEP_ALIVE_URL=""
RENDER_EXTERNAL_URL=""
