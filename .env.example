# ==========================================
# TeleMemer - Telegram RPG & Economy Bot Config
# ==========================================

# Telegram Bot Token obtained from @BotFather on Telegram (Required)
BOT_TOKEN="1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# Telegram Bot Username (without @)
